/*
 * Sofle keymap adapted for the Cornix layout.
 *
 * The source Sofle keymap has 60 switch positions while this Cornix keymap
 * exposes 50 positions (12 + 12 + 14 + 12). The alpha rows and the Sofle
 * 14-key bottom row are kept in their relative positions. The dedicated
 * Sofle number row has no direct Cornix equivalent:
 *   - Esc and ~ are moved to the two outer bottom positions.
 *   - Numbers remain available on NAV.
 *   - F1..F12 are available from ADJ (bottom row).
 *
 * SPDX-License-Identifier: MIT
 */

#include "zmk-helpers/helper.h"
#include "includes/cornix54.h"

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE 0
#define NAV  1
#define ADJ  2
#define GAME 3

/* Keep the Sofle hold-tap timing. */
&lt {
    tapping-term-ms = <280>;
    quick-tap-ms = <175>;
    require-prior-idle-ms = <150>;
    flavor = "balanced";
};

&mt {
    tapping-term-ms = <280>;
    quick-tap-ms = <175>;
    require-prior-idle-ms = <150>;
    flavor = "balanced";
};

/*
 * Sofle has RGB underglow bindings on ADJ. Cornix configurations do not
 * always enable ZMK RGB underglow, so make those bindings compile-safe.
 */
#ifdef CONFIG_ZMK_RGB_UNDERGLOW
#define SOFLE_RGB_BRD &rgb_ug RGB_BRD
#define SOFLE_RGB_TOG &rgb_ug RGB_TOG
#define SOFLE_RGB_BRI &rgb_ug RGB_BRI
#else
#define SOFLE_RGB_BRD &none
#define SOFLE_RGB_TOG &none
#define SOFLE_RGB_BRI &none
#endif

/* ZMK Studio is optional on Cornix builds. */
#ifdef CONFIG_ZMK_STUDIO
#define SOFLE_STUDIO_UNLOCK &studio_unlock
#else
#define SOFLE_STUDIO_UNLOCK &none
#endif

/ {
    combos {
        compatible = "zmk,combos";

        /* Sofle J + K + L -> Esc, remapped to Cornix positions. */
        r_esc {
            bindings = <&kp ESC>;
            key-positions = <19 20 21>;
            layers = <BASE GAME>;
        };

        /* Sofle S + D + F -> Esc, remapped to Cornix positions. */
        l_esc {
            bindings = <&kp ESC>;
            key-positions = <14 15 16>;
            layers = <BASE>;
        };

        /* Space + Enter -> Shift+Alt, preserving the Sofle combo. */
        switch_input {
            bindings = <&kp LS(LALT)>;
            key-positions = <43 44>;
            layers = <BASE>;
        };
    };

    behaviors {
        f1_f11: F11_tap_dance {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp F1>, <&kp F11>;
        };

        f2_f12: F12_tap_dance {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp F2>, <&kp F12>;
        };

        slash_backslash: slash_tap_dance {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp FSLH>, <&kp BACKSLASH>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        BASE {
            display-name = "BASE";

            /*
             * Cornix positions:
             *  0..11   : Sofle Q row
             * 12..23   : Sofle A row
             * 24..37   : Sofle Z row (14 positions map 1:1)
             * 38..49   : Esc + Sofle thumbs + ~
             */
            bindings = <
&kp TAB    &kp Q       &kp W        &kp E       &kp R        &kp T                            &kp Y          &kp U         &kp I      &kp O      &kp P             &kp RIGHT_BRACKET
&kp LSHFT  &kp A       &kp S        &kp D       &kp F        &kp G                            &kp H          &kp J         &kp K      &kp L      &kp SEMI          &kp SQT
&kp LCTRL  &kp Z       &kp X        &kp C       &kp V        &kp B       &kp C_MUTE  &kp C_PP  &kp N          &kp M         &kp COMMA  &kp DOT    &slash_backslash  &mt RSHFT LEFT_BRACKET
&kp ESC    &kp LGUI    &kp F12      &kp LALT    &kp DEL      &lt NAV SPACE                    &lt NAV ENTER  &kp BACKSPACE &kp RALT   &kp MINUS  &kp EQUAL         &kp TILDE
            >;

            /* Use Cornix's board-defined sensors; only copy Sofle actions. */
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_NEXT C_PREV>;
        };

        NAV {
            display-name = "NAV";

            /*
             * The Sofle NAV mappings under Q/A/Z and the thumb cluster are
             * preserved. The Sofle function-key number row is moved to ADJ.
             */
            bindings = <
&none      &none       &kp N7       &kp N8      &kp N9       &kp EQUAL                         &none          &kp LC(MINUS) &kp UP     &kp LC(EQUAL) &none       &none
&none      &none       &kp N4       &kp N5      &kp N6       &kp STAR                          &none          &kp LEFT      &kp DOWN   &kp RIGHT     &none       &none
&tog ADJ   &none       &kp N1       &kp N2      &kp N3       &kp FSLH    &none       &none      &none          &none         &none      &none         &none       &tog ADJ
&tog GAME  &kp N0      &kp MINUS    &kp PLUS    &kp COMMA    &trans                            &trans         &none         &kp INSERT &kp C_MENU    &kp KP_NUM  &tog GAME
            >;
        };

        ADJ {
            display-name = "ADJ";

            /*
             * System/output controls from the Sofle number row are kept here.
             * RGB actions are active only when CONFIG_ZMK_RGB_UNDERGLOW exists.
             * F1..F12 are moved to the bottom row because Cornix has no number row.
             */
            bindings = <
&out OUT_BLE  &none              &bootloader          &ext_power EP_TOG  SOFLE_STUDIO_UNLOCK  &none                         &none  SOFLE_STUDIO_UNLOCK  &ext_power EP_TOG  &bootloader         &none       &out OUT_USB
&none         &none              SOFLE_RGB_BRD        SOFLE_RGB_TOG     SOFLE_RGB_BRI         &none                         &none  SOFLE_RGB_BRD        SOFLE_RGB_TOG       SOFLE_RGB_BRI       &none       &none
&tog ADJ      &none              &bt BT_SEL 0         &bt BT_CLR        &bt BT_SEL 1           &none      &none      &none    &none  &bt BT_SEL 1         &bt BT_CLR          &bt BT_SEL 0        &none       &tog ADJ
&tog GAME     &f1_f11            &f2_f12              &kp F3            &kp F4                 &kp F5                       &kp F6 &kp F7               &kp F8               &kp F9              &kp F10     &tog GAME
            >;
        };

        GAME {
            display-name = "GAME";

            /*
             * The Sofle GAME Q/A/Z rows and thumb cluster are preserved.
             * The Sofle dedicated 1..0 row has no direct Cornix counterpart.
             */
            bindings = <
&kp N6      &kp TAB      &kp Q       &kp W       &kp E       &kp R                              &kp T       &kp Y        &kp U      &kp I      &kp O       &kp RIGHT_BRACKET
&kp N7      &kp LSHFT    &kp A       &kp S       &kp D       &kp F                              &kp G       &kp H        &kp J      &kp K      &kp L       &kp SQT
&kp N8      &kp LCTRL    &kp Z       &kp X       &kp C       &kp V       &kp C_MUTE  &kp C_PP   &kp B       &kp N        &kp UP     &kp COMMA  &kp DOT     &kp LEFT_BRACKET
&tog GAME   &kp F5       &kp F6      &kp N9      &kp LALT    &kp SPACE                          &kp ENTER   &tog GAME    &kp LEFT   &kp DOWN   &kp RIGHT   &tog GAME
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_NEXT C_PREV>;
        };
    };
};
